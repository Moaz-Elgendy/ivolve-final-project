# Copy to terraform.tfvars (git-ignored) and fill in. Terraform loads it automatically.
project_name = "ivolve"
vpc_cidr     = "10.0.0.0/16"

# One Jenkins host serves dev, stg and prod
instance_type = "t3.small"
key_name      = "ivolve-key" # must already exist in the region

# Your public IP, e.g. ["1.2.3.4/32"]. Do not commit the real value.
ssh_cidr_blocks         = ["<YOUR_IP>/32"]
eks_public_access_cidrs = ["<YOUR_IP>/32"]

# One ECR repo per service per environment: frontend-dev, frontend-stg, ...
services     = ["frontend", "auth-service", "roadmap-service"]
environments = ["dev", "stg", "prod"]

cluster_version     = "1.35"
node_instance_types = ["m7i-flex.large"]
